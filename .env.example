# Copy this file to .env for local development (npm run dev).
# Docker Compose sets its own values, see docker-compose.yml.
DATABASE_URL="postgresql://his:his@localhost:5432/his?schema=public"
# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"
