    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.7.0",
    "postcss": "8.5.33",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
